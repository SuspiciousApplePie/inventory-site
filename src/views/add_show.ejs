<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add show</title>
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/form.css" />
  </head>
  <body>
    <div class="app">
      <header><%- include('./partials/navbar.ejs'); %></header>
      <main>
        <div class="form-wrapper">
          <h1>New Show</h1>
          <form action="/add_show" method="post" novalidate>
            <%- include("./partials/errors.ejs"); %>

            <div class="form-control">
              <label for="title">Title <span class="required">*</span></label>
              <input type="text" name="title" id="title"  />
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="start-date"
                  >Start <span class="required">*</span></label
                >
                <input type="date" name="start-date" id="start-date" />
              </div>

              <div class="form-control">
                <label for="end-date">End</label>
                <input type="date" name="end-date" id="end-date" />
              </div>
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="format"
                  >Format <span class="required">*</span></label
                >
                <select name="format" id="format">
                  <%- include("./partials/formats.ejs", { formats: formats }); %>  
                </select>
              </div>

              <div class="form-control">
                <label for="rating"
                  >Rating <span class="required">*</span></label
                >
                <input
                  type="number"
                  name="rating"
                  id="rating"
                  min="1"
                  max="10"
                  value="5"
                />
              </div>
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="genre">Genre <span class="required">*</span></label>
                <select name="genre" id="genre" multiple>
                  <%- include("./partials/genres.ejs", { genres: genres }); %>  
                </select>
              </div>

              <div class="form-control">
                <label for="studio"
                  >Studio <span class="required">*</span></label
                >
                <select name="studio" id="studio" multiple>
                  <%- include("./partials/studios.ejs", { studios: studios }); %>
                </select>
              </div>
            </div>

            <%- include("./partials/password.ejs"); %>

            <div class="btn-wrapper">
              <a href="/shows">Cancel</a>
              <button type="submit">Save</button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
