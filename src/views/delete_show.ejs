<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/form.css" />
    <title>Delete</title>
  </head>
  <body>
    <div class="app">
      <header><%- include('./partials/navbar.ejs'); %></header>
      <main>
        <div class="form-wrapper delete">
          <h1>Delete <%= show.title %>?</h1>
          <form action="/delete_show/<%= show.animeId %>" method="post">
            <p>
              Are you sure you want to delete this show?<br />Type the password
            </p>
            <%- include("./partials/password.ejs"); %> <%-
            include("./partials/errors.ejs"); %>
            <div class="btn-wrapper">
              <button><a href="/shows">Cancel</a></button>
              <button type="submit">Yes</button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
