<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delete</title>
  </head>
  <body>
    <h1>Delete <%= show.title %>?</h1>
    <form action="/delete_show/<%= show.animeId %>" method="post">
      <p>Are you sure you want to delete this show?</p>
      <button type="submit">Yes</button>
    </form>
  </body>
</html>
