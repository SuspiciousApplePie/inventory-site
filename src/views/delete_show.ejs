<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delete</title>
  </head>
  <body>
    <%- include("./partials/navbar.ejs") %> <%-
    include("./partials/backBtn.ejs")%>
    <h1>Delete <%= show.title %>?</h1>
    <form action="/delete_show/<%= show.animeId %>" method="post">
      <p>Are you sure you want to delete this show?Type the password</p>
      <%- include("./partials/password.ejs"); %> <%-
      include("./partials/errors.ejs"); %>
      <button><a href="/shows">Cancel</a></button>
      <button type="submit">Yes</button>
    </form>
  </body>
</html>
