<div class="shows">
    <% shows.forEach((show) => { %>
        <div class="show">
            <div class="image">
                <img src="https://picsum.photos/seed/picsum/200/300" alt="img" width="200" height="300">
            </div>
            <div class="description">
                <h1 class="title"><%= show.title %></h1>
                <h2 class="rating">Rating: <%= show.rating %></h2>
                <h3 class="format"><%= show.format %></h3>
                <h3 class="season"><%= getSeason(show.startDate) %></h3>
                <ul class="genre-list">
                    <% for (const genre of show.genres) { %>
                        <li><%= genre %></li>
                    <% }; %>
                </ul>
                <div class="air-date"> 
                    <h4>Aired</h4>
                    <section>
                        <time datetime="<%= show.startDate %>">
                            <%= formatDate(show.startDate, "dd MMMM yyyy") %>
                        </time> 
                        to 
                        <time datetime="<%= show.endDate || ''%>">
                            <%= show.endDate ? formatDate(show.endDate, "dd MMMM yyyy") : "???" %>
                        </time>
                    </section>
                </div>
    
                <ul class="studio-list">
                    <% for (const studio of show.studios) { %>
                        <li><%= studio %></li>
                    <% }; %>
                </ul>
                <div class="buttons">
                    <button type="button" tabindex="-1">
                        <a href="<%= `/update_show/${show.animeId}` %>">Edit</a>
                    </button>
                    <button type="button" tabindex="-1">
                        <a href="<%= `/delete_show/${show.animeId}` %>">Delete</a>
                    </button>
                </div>
            </div>
        </div>
    <% }); %>
</div>