<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anime List</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <header>
      <%- include("./partials/navbar.ejs", { navBar, active }); %>
      <%- include("./partials/search.ejs"); %>
    </header>
    <main>
        <a href="/add_show" class="add_show" aria-label="Add show">
          <?xml version="1.0" encoding="UTF-8"?>
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" >
            <path d="M6 12H12M18 12H12M12 12V6M12 12V18"></path>
          </svg>
        </a>
      <%- 
        shows.size !== 0 ? 
        include("./partials/showsList.ejs") : 
        include("./partials/emptyShows.ejs"); 
      %>

      <%- include("./partials/pagination.ejs", { pageURLs: pageURLs, prev: prev, next: next }); %>
    </main>
  </body>
</html>
