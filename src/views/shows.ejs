<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anime List</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <header>
      <%- include("./partials/navbar.ejs", { navBar, active }); %>
    </header>
    <main>
    <%- include("./partials/search.ejs"); %>
    <button><a href="/add_show">Add a show</a></button>
    <%- 
      shows.size !== 0 ? 
      include("./partials/showsList.ejs", { shows: shows }) : 
      include("./partials/emptyShows.ejs"); 
    %>
    <% if (prev) { %>
      <a href="<%= `/shows?${prev.url}` %>">Prev</a>
    <% } %>
    <%- include("./partials/pagination.ejs", { pageURLs: pageURLs }); %>
    <% if (next) { %>
      <a href="<%= `/shows?${next.url}` %>">Next</a>
    <% } %>
  </body>
</html>
