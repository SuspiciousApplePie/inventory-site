<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anime List</title>
  </head>
  <body>
    <%- include('./partials/navbar.ejs') %>
    <search>
      <form action="/shows" method="get">
        <input
          type="search"
          name="search"
          id="search"
          placeholder="Search anime"
        />
        <button type="submit">Search</button>
      </form>
      <%- include("./partials/errors.ejs") %>
    </search>
    <button><a href="/add_show">Add a show</a></button>
    <%- include("./partials/filterForm.ejs"); %>
    <%- shows.size !== 0 ? include("./partials/showsList.ejs", { shows: shows }) : include("./partials/emptyShows.ejs"); %>
  </body>
</html>
