<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anime List</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <header>
      <%- include("./partials/navbar.ejs", { navBar, active }); %>
      <%- include("./partials/search.ejs"); %>
    </header>
    <main>
      <button><a href="/add_show">Add a show</a></button>
      <%- 
        shows.size !== 0 ? 
        include("./partials/showsList.ejs") : 
        include("./partials/emptyShows.ejs"); 
      %>

      <%- include("./partials/pagination.ejs", { pageURLs: pageURLs, prev: prev, next: next }); %>
    </main>
  </body>
</html>
