<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= show.title %></title>
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/form.css" />
    <link rel="preload" href="/fonts//font/Inter-Regular.woff2" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts//font/Inter-Regular.woff" type="font/woff" crossorigin>
  </head>
  <body>
    <div class="app">
      <header><%- include('./partials/navbar.ejs'); %></header>
      <main>
        <div class="form-wrapper">
          <h1>Edit</h1>
          <form
            action="/update_show/<%= show.animeId %>"
            method="post"
            novalidate
          >
            <%- include("./partials/errors.ejs"); %>

            <div class="form-control">
              <label for="new-title">Title</label>
              <input
                type="text"
                name="new-title"
                id="new-title"
                value="<%= show.title %>"
              />
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="start-date">Start</label>
                <input
                  type="date"
                  name="start-date"
                  id="start-date"
                  value="<%= formatDate(show.startDate, 'yyyy-MM-dd'); %>"
                />
              </div>
              <div class="form-control">
                <label for="end-date">End</label>
                <input
                  type="date"
                  name="end-date"
                  id="end-date"
                  value="<%= show.endDate ? formatDate(show.endDate, 'yyyy-MM-dd') : null %>"
                />
              </div>
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="format">Format</label>
                <select name="format" id="format">
                  <% for (const format of formats) { %>
                    <% if (show.format === format.format_id) { %>
                      <option selected value=<%= format.format_id %>><%= format.format_name %></option>
                    <% } else { %>
                      <option value=<%= format.format_id %>><%= format.format_name %></option>
                    <% } %>
                  <% } %>
                </select>
              </div>
              <div class="form-control">
                <label for="rating">Rating</label>
                <input
                  type="number"
                  name="rating"
                  id="rating"
                  value="<%= show.rating %>"
                  min="1"
                  max="10"
                />
              </div>
            </div>

            <div class="joint-field">
              <div class="form-control">
                <label for="genre">Genre</label>
                <select name="genre" id="genre" multiple>
                  <% for (const genre of genres) { %>
                    <% if (show.genres.has(genre.genre_id)) { %>
                      <option selected value=<%= genre.genre_id %>><%= genre.genre_name %></option>
                    <% } else { %>
                      <option value=<%= genre.genre_id %>><%= genre.genre_name %></option>
                    <% } %>
                  <% } %>
                </select>
              </div>
              <div class="form-control">
                <label for="studio">Studio</label>
                <select name="studio" id="studio" multiple>
                  <% for (const studio of studios) { %>
                    <% if (show.studios.has(studio.studio_id)) { %>
                      <option selected value=<%= studio.studio_id %>><%= studio.studio_name %></option>
                    <% } else { %>
                      <option value=<%= studio.studio_id %>><%= studio.studio_name %></option>
                    <% } %>
                  <% } %>
                </select>
              </div>
            </div>

            <%- include("./partials/password.ejs") %> 

            <div class="btn-wrapper">
              <a href="/shows">Cancel</a>
              <button type="submit">Save</button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
